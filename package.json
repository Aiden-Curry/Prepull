{
  "name": "prepull",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types tests/gear-analysis.test.ts tests/guilds.test.ts tests/settings.test.ts tests/main-alt.test.ts tests/production-config.test.ts tests/image-trust.test.ts tests/saved-characters.test.ts tests/player-advice.test.ts tests/character-sync.test.ts tests/session-planner.test.ts tests/recommendation-registry.test.ts tests/mage-recommendations.test.ts tests/additional-recommendations.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/postgres.integration.test.ts tests/postgres.workflows.integration.test.ts tests/postgres.settings.integration.test.ts tests/postgres.raid.integration.test.ts tests/postgres.main-alt.integration.test.ts tests/postgres.saved-characters.integration.test.ts tests/postgres.character-sync.integration.test.ts",
    "validate:gear": "node --experimental-strip-types scripts/validate-gear-dataset.ts",
    "validate:curated": "node --experimental-strip-types scripts/validate-curated-gear.ts",
    "curated:import": "node --experimental-strip-types scripts/curated-import.ts",
    "curated:export": "node --experimental-strip-types scripts/curated-export.ts",
    "curated:template": "node --experimental-strip-types scripts/curated-template.ts",
    "curated:inspect": "node --experimental-strip-types scripts/curated-inspect.ts",
    "curated:test-character": "node --experimental-strip-types scripts/curated-test-character.ts",
    "curated:review": "node --experimental-strip-types scripts/curated-review.ts",
    "curated:candidates": "node --experimental-strip-types scripts/curated-candidates.ts",
    "curated:availability": "node --experimental-strip-types scripts/curated-availability.ts",
    "items:sync-curated": "node --experimental-strip-types scripts/items-sync-curated.ts",
    "calibrate:fury": "node --experimental-strip-types scripts/calibrate-fury.ts",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts",
    "db:status": "node --experimental-strip-types scripts/db-status.ts",
    "db:seed": "node --experimental-strip-types scripts/db-seed.ts",
    "db:dev:up": "docker compose --profile development up -d postgres",
    "db:dev:down": "docker compose --profile development down",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "db:test:down": "docker compose --profile test down",
    "snapshot:fury": "node --experimental-strip-types scripts/export-fury-snapshot.ts",
    "snapshot:spec": "node --experimental-strip-types scripts/snapshot-spec.ts",
    "validate:spec": "node --experimental-strip-types scripts/validate-spec.ts",
    "generate:support-docs": "node --experimental-strip-types scripts/generate-support-docs.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "config:check:production": "node --experimental-strip-types scripts/config-check-production.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:seed:e2e": "node --experimental-strip-types scripts/db-seed-e2e.ts",
    "acceptance:guilds": "npm run config:check:production && npm run test:e2e",
    "test:security": "npm run test:integration",
    "validate:action-inventory": "node --experimental-strip-types scripts/validate-action-inventory.ts",
    "validate:action-coverage": "node --experimental-strip-types scripts/validate-action-coverage.ts",
    "acceptance:deployment": "node --experimental-strip-types scripts/acceptance-deployment.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "15.5.21",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.55.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.16.11",
    "@types/pg": "^8.21.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
